# ── Pre-launch (Google Sheet) setup: see docs/DEPLOY.md ──
# "sheet" = waitlist rows go to a Google Sheet, no database needed. "supabase" = the database.
WAITLIST_STORE=sheet
# Apps Script web app URL (ends in /exec) and the secret its setup() printed.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Copy to .env.local for local work; add the same names in Vercel → Settings → Environment Variables.
# Never commit .env.local. Only the two NEXT_PUBLIC_ values are safe for the browser.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Skips row level security: used just for sending email alerts and unsubscribe links.
SUPABASE_SERVICE_ROLE_KEY=

# Your live address, used in email links (e.g. https://nayboro.app)
NEXT_PUBLIC_SITE_URL=

# Email alerts (resend.com → API Keys). The sender must be on a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Nayboro <hello@yourdomain.com>

# Long random strings (run: openssl rand -base64 32)
NOTIFY_WEBHOOK_SECRET=
CRON_SECRET=
UNSUBSCRIBE_SECRET=
# Salt for hashing visitors' network address (waitlist spam limit). Any long random string.
IP_HASH_SALT=
